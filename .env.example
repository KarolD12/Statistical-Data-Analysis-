# Copia este archivo como .env y completa lo que uses.

# Proveedor del LLM: groq (nube) u ollama (local)
LLM_PROVIDER=groq

# Groq: clave en https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Ollama: https://ollama.com  ·  descarga el modelo con: ollama pull llama3.2:3b
OLLAMA_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434
